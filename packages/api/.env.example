# Capa 5 — Brains / IA
# La key Anthropic se carga desde acá vía dotenv.
# Copiar a `.env` (gitignored) con tu key real.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Modelo (default si no se setea: claude-sonnet-4-5)
# SMARTOS_CHAT_MODEL=claude-sonnet-4-5
# SMARTOS_CHAT_LIGHT=claude-haiku-4-5
# SMARTOS_FORCE_TIER=light|standard

# Capa 7 — Governance
# Si está seteada, /chat /chat/sesiones /agent/actions
# requieren `Authorization: Bearer <token>`.
# Si no está seteada, modo dev: pasa todo.
# SMARTOS_API_TOKEN=cambiame-por-un-uuid

# Puerto del server (default 3001)
# PORT=3001
