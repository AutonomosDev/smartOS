# Copia este archivo a `.env` y ajusta valores locales si los puertos están ocupados.

# Postgres local (mapeado a 54320 en host para no chocar con instalaciones nativas)
DATABASE_URL=postgres://smartos:smartos@localhost:54320/smartos

# GCS emulator (fake-gcs-server) — landing del archivo crudo
GCS_EMULATOR_URL=http://localhost:4443
GCS_BUCKET=smartos-raw-local

# Server HTTP de la capa de ingestión
PORT=3000
